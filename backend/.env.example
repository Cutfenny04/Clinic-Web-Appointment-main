# ═══════════════════════════════════════════════════════
#  JanjiCare Backend — Environment Variables
#  Salin file ini menjadi .env dan isi nilainya.
#  JANGAN commit file .env ke Git.
# ═══════════════════════════════════════════════════════

# App
NODE_ENV=development
PORT=3000

# Frontend URL (untuk CORS)
FRONTEND_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────────────
# Dapatkan dari: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# ── Queue Service (diisi saat FASE 8) ────────────────
# QUEUE_SERVICE_URL=http://localhost:3002