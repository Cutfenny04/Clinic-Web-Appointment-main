# JanjiCare Backend API — rahasia HANYA di server (EC2 / Parameter Store), jangan ke frontend
NODE_ENV=development
PORT=3000

# Origin frontend yang diizinkan (pisahkan dengan koma bila lebih dari satu)
FRONTEND_URL=http://localhost:5173

# Supabase (sementara, sebelum migrasi Auth/DB ke AWS)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Service role: hanya untuk membuat akun dokter/admin. JANGAN pernah dikirim ke frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Queue Microservice (token harus sama persis dengan services/queue-service/.env)
QUEUE_SERVICE_URL=http://localhost:3002/api/v1/queue
QUEUE_INTERNAL_TOKEN=ganti-dengan-token-acak-panjang

# Opsional
RATE_LIMIT_MAX=600

# Foto profil dokter (lihat backend/sql/03_doctor_photos.sql)
# Saat ini: Supabase Storage (memakai SUPABASE_SERVICE_ROLE_KEY di atas, hanya di server)
STORAGE_PROVIDER=supabase
DOCTOR_PHOTO_BUCKET=doctor-photos
# Opsional: domain CDN untuk URL foto (mis. CloudFront di depan S3). Kosongkan = URL publik Supabase.
PUBLIC_PHOTO_BASE_URL=
