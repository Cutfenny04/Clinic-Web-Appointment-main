# backend/.env di EC2 "app"
NODE_ENV=production
PORT=3000
# CloudFront → Nginx → Express (2 proxy) agar rate limit membaca IP pengguna asli
TRUST_PROXY=2
FRONTEND_URL=https://<DOMAIN_CLOUDFRONT>

# "Supabase" sekarang = GoTrue + PostgREST milik sendiri di EC2 ini (lewat Nginx port 80)
SUPABASE_URL=http://127.0.0.1
SUPABASE_PUBLISHABLE_KEY=<ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Queue service di EC2 kedua (IP privat, port 3002 hanya dibuka untuk security group EC2 app)
QUEUE_SERVICE_URL=http://<IP_PRIVAT_EC2_QUEUE>:3002/api/v1/queue
QUEUE_INTERNAL_TOKEN=<QUEUE_INTERNAL_TOKEN>

# Foto dokter di Amazon S3 (kredensial otomatis dari LabInstanceProfile)
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
S3_BUCKET=<BUCKET_FOTO>
S3_KEY_PREFIX=doctor-photos/
PUBLIC_PHOTO_BASE_URL=https://<DOMAIN_CLOUDFRONT>/doctor-photos
