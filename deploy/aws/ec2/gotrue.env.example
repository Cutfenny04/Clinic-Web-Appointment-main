# /opt/janjicare/config/gotrue.env — Supabase Auth (GoTrue) yang berjalan di EC2 "app"
# Ganti <...> dengan nilai Anda (lihat rahasia.env dari generate-keys.mjs)
GOTRUE_DB_DRIVER=postgres
DATABASE_URL="postgres://supabase_auth_admin:<AUTH_DB_PASSWORD>@<ENDPOINT_RDS>:5432/janjicare?search_path=auth&sslmode=require"
GOTRUE_DB_MIGRATIONS_PATH=/opt/janjicare/auth/migrations
GOTRUE_API_HOST=127.0.0.1
PORT=9999
API_EXTERNAL_URL=https://<DOMAIN_CLOUDFRONT>/auth/v1
GOTRUE_SITE_URL=https://<DOMAIN_CLOUDFRONT>

GOTRUE_JWT_SECRET=<JWT_SECRET>
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role

# Daftar pasien lewat email tanpa verifikasi (Learner Lab tidak menyediakan SMTP/SES produksi)
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_SMTP_ADMIN_EMAIL=noreply@janjicare.local
GOTRUE_RATE_LIMIT_EMAIL_SENT=1000
