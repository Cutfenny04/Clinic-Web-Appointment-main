# services/queue-service/.env di EC2 "queue"
NODE_ENV=production
PORT=3002
# Master user RDS (pemilik tabel queue_tickets)
DATABASE_URL=postgres://postgres:<PASSWORD_MASTER_RDS>@<ENDPOINT_RDS>:5432/janjicare
DATABASE_SSL=true
QUEUE_INTERNAL_TOKEN=<QUEUE_INTERNAL_TOKEN>
MAIN_BACKEND_URL=http://<IP_PRIVAT_EC2_APP>
